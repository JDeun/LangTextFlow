  "metric_definitions": {
    "cer_wer": "Existing benchmark.quality_metrics; NFKC/casefold/space normalization, character CER excludes spaces, WER uses whitespace; each clip rounded to four decimals before macro mean over eight clips.",
    "repeats": "Two repetitions per model/window, eight unique clips rather than sixteen independent observations.",
    "timing": "PCM16-to-float conversion plus synchronous product decode, VAD and retries; excludes model load, queueing, pacing and display",
    "rtf": "Mean of per-clip (sum chunk decode+conversion seconds / clip audio seconds).",
    "p95": "Nearest-rank across 27 four-second or 15 eight-second chunks per arm; tail durations differ and it is not live latency.",
    "load_seconds": "Fresh-process model initialization measured separately after hashing files; filesystem cache warmth not controlled.",
    "memory": "one child process lifetime high-water through scoring before final serialization; not process-tree, co-resident MT or physical-device fit; Darwin ru_maxrss is bytes, converted by /1048576 to MiB.",
    "timing_recovery": "Counters are retry attempts, not word alignment; estimated segment flags also include bounded VAD-tail normalization."
  },
  "limits": [
    "KO read speech only, not sermon/domain semantics or six directions",
    "synchronous native decode, not runtime queues or browser/live caption latency",
    "same host; incidental development/system load is uncontrolled",
    "OS filesystem/model cache warmth is not equalized; ABBA is only drift mitigation",
    "process high-water RSS, not process-tree or physical 4/8GB qualification",
    "no model/default promotion or optimal combination claim",
    "Not a controlled before/after against historical hosted CI: different synchronous harness/context/environment, no caption queue/dedup/pacing path.",
    "Lower small-model CER on this cohort trades against more decode time/RSS; no default/model promotion or optimal combination selection.",
    "The previous thirty-minute failure and six-failed-target recovery receipts remain unchanged and unqualified.",
