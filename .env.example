# LangTextFlow backend
LANGTEXTFLOW_ENVIRONMENT=development
LANGTEXTFLOW_DATABASE_PATH=data/langtextflow.db
LANGTEXTFLOW_FRONTEND_PORT=5173
LANGTEXTFLOW_BACKEND_PORT=8000

# Streaming ASR
LANGTEXTFLOW_VIBEVOICE_URL=http://127.0.0.1:8001
# Optional managed sidecar lifecycle. Leave blank to use an externally started sidecar.
# These paths must point to an already prepared VibeVoice repo/runtime and local streaming checkpoint.
LANGTEXTFLOW_VIBEVOICE_REPO_PATH=
LANGTEXTFLOW_VIBEVOICE_PYTHON=
LANGTEXTFLOW_VIBEVOICE_MODEL_PATH=
LANGTEXTFLOW_VIBEVOICE_TENSOR_PARALLEL_SIZE=1
LANGTEXTFLOW_VIBEVOICE_MAX_MODEL_LEN=16384
LANGTEXTFLOW_VIBEVOICE_MAX_AUDIO_WINDOWS=512
LANGTEXTFLOW_VIBEVOICE_MM_PROCESSOR_CACHE_GB=16.0
LANGTEXTFLOW_VIBEVOICE_GPU_MEMORY_UTILIZATION=0.85
LANGTEXTFLOW_VIBEVOICE_STARTUP_TIMEOUT_SECONDS=600.0
LANGTEXTFLOW_AUDIO_QUEUE_CHUNKS=32
LANGTEXTFLOW_ASR_REPLAY_SECONDS=8.0
LANGTEXTFLOW_ASR_HEALTH_CHECK_SECONDS=0.25
LANGTEXTFLOW_FASTER_WHISPER_MODEL=small
LANGTEXTFLOW_FASTER_WHISPER_DEVICE=auto
LANGTEXTFLOW_FASTER_WHISPER_COMPUTE_TYPE=default
LANGTEXTFLOW_FASTER_WHISPER_CHUNK_SECONDS=4.0

# Realtime monitoring
LANGTEXTFLOW_VAD_THRESHOLD_DBFS=-45.0
LANGTEXTFLOW_VAD_HANGOVER_FRAMES=3
LANGTEXTFLOW_AUDIO_BACKPRESSURE_WARN_MS=50.0

# Local translation
LANGTEXTFLOW_OLLAMA_URL=http://127.0.0.1:11434
LANGTEXTFLOW_OLLAMA_TRANSLATION_MODEL=translategemma:4b
