{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LangTextFlow",
  "version": "0.12.0",
  "identifier": "dev.langtextflow.app",
  "build": {
    "beforeBuildCommand": "cd ../../web && npm run build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "LangTextFlow",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' http://127.0.0.1:8000 ws://127.0.0.1:8000 http://localhost:8000 ws://localhost:8000; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/langtextflow-server"
    ],
    "createUpdaterArtifacts": false
  }
}
